<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>Spike.Frame</AssemblyName>
    <RootNamespace>SpikeFrame</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      必须指定 RID：否则原生依赖（libSkiaSharp.dll）只落在 runtimes/win-x64/native，
      而 Windows 的 DLL 搜索会把 PATH 上的同名库抢先命中——本机 Git for Windows
      自带的 libSkiaSharp.dll 是 2.88，会让 SkiaSharp 3.119 直接崩。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

</Project>
