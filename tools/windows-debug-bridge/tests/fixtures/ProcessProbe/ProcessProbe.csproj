<Project Sdk="Microsoft.NET.Sdk">

  <!--
    进程存活探针（fixture）：给 WSL 侧 windows-smoke.py 判「Windows 进程树是否真的全没了」用。

    硬性约束（与 EchoApp 同款）：
      * 零 NuGet、纯 BCL —— 桥会把源码复制到仓库之外（%LOCALAPPDATA%\WslDebugBridge）再构建，
        离线也必须能还原；因此自带 TargetFramework，不依赖仓库根的
        Directory.Build.props / Directory.Packages.props；
      * 只做只读查询：GetProcessById / HasExited / ProcessName / StartTime，
        绝不调用 Kill / CloseMainWindow / Dispose 之外的任何写操作，也不按 PID 杀进程。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ProcessProbe</AssemblyName>
    <RootNamespace>ProcessProbe</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsPackable>false</IsPackable>
    <!-- 仓库根 Directory.Build.props 打开了中央包版本管理；本 fixture 零包引用，显式关掉更直白。 -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
