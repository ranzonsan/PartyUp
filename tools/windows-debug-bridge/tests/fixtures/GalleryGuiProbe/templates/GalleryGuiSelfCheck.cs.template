    /// <summary>
    /// 可视树旁证：从**真实已在屏上渲染的控件**读取关键可见性与下拉项，证明"界面上确实长这样"，
    /// 而不只是 ViewModel 里布尔值为真。只读，不触发任何交互命令。
    /// </summary>
    private static Dictionary<string, object?>? TryProbeVisualTree(Window? window)
    {
        if (window is null)
            return null;
        try
        {
            var probe = new Dictionary<string, object?>();
            var view = window.GetVisualDescendants().OfType<GalleriesManager.Desktop.Views.SettingsView>().FirstOrDefault();
            probe["settingsViewPresent"] = view is not null;
            if (view is null)
                return probe;

            probe["settingsViewVisible"] = view.IsVisible;
            probe["settingsViewAttached"] = view.IsAttachedToVisualTree();

            // 内层 TabControl 当前选中的子页标题（应为「LLM 助手」）
            var tab = view.GetVisualDescendants().OfType<TabControl>().FirstOrDefault();
            probe["settingsTabIndex"] = tab?.SelectedIndex;
            if (tab?.SelectedItem is TabItem ti && ti.Header is StackPanel sp)
                probe["settingsTabHeader"] = sp.GetVisualDescendants().OfType<TextBlock>()
                    .Select(t => t.Text).FirstOrDefault(t => !string.IsNullOrWhiteSpace(t));

            // 下拉项：把每个 ComboBox 的 ItemsSource 与当前可见性如实列出，供 WSL 侧核对
            var combos = new List<Dictionary<string, object?>>();
            foreach (var cb in view.GetVisualDescendants().OfType<ComboBox>())
            {
                var items = (cb.ItemsSource as System.Collections.IEnumerable)?
                    .Cast<object?>().Select(x => x?.ToString()).Where(x => x is not null).ToList()
                    ?? new List<string?>();
                combos.Add(new Dictionary<string, object?>
                {
                    ["items"] = items,
                    ["itemCount"] = items.Count,
                    ["selected"] = cb.SelectedItem?.ToString(),
                    ["isEffectivelyVisible"] = cb.IsEffectivelyVisible,
                });
            }
            probe["comboBoxes"] = combos;

            // 在线配置卡的两个输入框（按 PlaceholderText 精确定位，不依赖 VisualTree 顺序）
            var boxes = view.GetVisualDescendants().OfType<TextBox>()
                .GroupBy(t => t.PlaceholderText ?? string.Empty)
                .Where(g => g.Key.Length > 0)
                .ToDictionary(g => g.Key, g => new Dictionary<string, object?>
                {
                    ["count"] = g.Count(),
                    ["isEffectivelyVisible"] = g.Count(t => t.IsEffectivelyVisible),
                    ["text"] = g.Select(t => t.Text ?? string.Empty).Distinct().ToList(),
                    ["isPasswordBox"] = g.Any(t => t.PasswordChar != '\0'),
                });
            probe["textBoxesByPlaceholder"] = boxes;

            // ---- 在线卡"是否被视口裁切"的机器判据数据源（缺陷 2 防回归）----
            // 语义：取**在线卡里最底部的可见控件**（模型名称输入框下方的提示行）的有效边界底边，
            // 与承载它的 ScrollViewer 视口底边比较；等价判据是"该态无垂直滚动需求"
            // （ExtentHeight <= ViewportHeight）。两者都写进自证 JSON，由 WSL 侧判定。
            probe["viewportFit"] = MeasureViewportFit(view, boxes);
            return probe;
        }
        catch (Exception ex)
        {
            return new Dictionary<string, object?> { ["error"] = ex.GetType().Name + ": " + ex.Message };
        }
    }

    /// <summary>
    /// 量测"LLM 子页内容是否被视口裁切"：找承载 LLM 子页的 ScrollViewer，比较
    ///   * 滚动需求：ExtentHeight vs ViewportHeight（相等以内 = 不需要垂直滚动）；
    ///   * 最底部可见控件（在线卡的"模型名称"输入框及其下方提示行）的有效边界底边是否落在视口内。
    /// 只读几何，不做任何滚动/交互。取不到时如实返回 null（上层 fail closed，绝不默认成功）。
    /// </summary>
    private static Dictionary<string, object?>? MeasureViewportFit(
        GalleriesManager.Desktop.Views.SettingsView view, Dictionary<string, Dictionary<string, object?>> boxes)
    {
        try
        {
            // 1) 定位承载 LLM 子页的 ScrollViewer：以"包含在线卡输入框的祖先"为准，避免误取其它子页的滚动容器。
            ScrollViewer? scroller = null;
            foreach (var key in boxes.Keys)
            {
                var tb = view.GetVisualDescendants().OfType<TextBox>()
                    .FirstOrDefault(t => (t.PlaceholderText ?? string.Empty) == key);
                if (tb is null) continue;
                scroller = tb.GetVisualAncestors().OfType<ScrollViewer>().FirstOrDefault();
                if (scroller is not null) break;
            }
            if (scroller is null)
                return new Dictionary<string, object?> { ["error"] = "未找到承载在线卡的 ScrollViewer" };

            // 2) 最底部可见控件：模型名称输入框下方的提示行（NoWrap 单行）。按"是否仍属于在线卡"判定：
            //    其垂直位置在模型输入框底部附近、且自身可见。
            var modelBox = view.GetVisualDescendants().OfType<TextBox>()
                .FirstOrDefault(t => (t.PlaceholderText ?? string.Empty).Contains("留空即用预设首选模型")
                             || (t.PlaceholderText ?? string.Empty).StartsWith("填写模型名", StringComparison.Ordinal));
            var modelBoxBottom = modelBox is null ? double.NaN : BoundsBottomIn(modelBox, scroller);

            TextBlock? bottomText = null;
            double bottomTextBottom = double.NegativeInfinity;
            foreach (var t in view.GetVisualDescendants().OfType<TextBlock>())
            {
                if (!t.IsEffectivelyVisible || string.IsNullOrWhiteSpace(t.Text)) continue;
                if (modelBox is null || double.IsNaN(modelBoxBottom)) continue;
                var top = BoundsTopIn(t, scroller);
                // 模型输入框底部下方 0~40px 内的首个文本行 = 模型提示行
                if (top >= modelBoxBottom - 2 && top <= modelBoxBottom + 40)
                {
                    var bot = BoundsBottomIn(t, scroller);
                    if (bot > bottomTextBottom)
                    {
                        bottomTextBottom = bot;
                        bottomText = t;
                    }
                }
            }

            var extentH = scroller.Extent.Height;
            var viewportH = scroller.Viewport.Height;
            var offsetY = scroller.Offset.Y;
            var scrollBarVisible = false;
            var vbar = scroller.GetVisualDescendants().OfType<ScrollBar>()
                .FirstOrDefault(b => b.Orientation == Avalonia.Layout.Orientation.Vertical);
            if (vbar is not null)
                scrollBarVisible = vbar.IsEffectivelyVisible;

            // ---- 绝对坐标（相对 **窗口客户区**）：不依赖 Extent/Viewport 语义，实测把校验钉死在几何上 ----
            var window = view.GetVisualAncestors().OfType<Window>().FirstOrDefault();
            var winClientH = window?.ClientSize.Height ?? double.NaN;
            var scrollerTopInWindow = window is null ? double.NaN : BoundsTopIn(scroller, window);
            var scrollerBottomInWindow = window is null ? double.NaN : BoundsBottomIn(scroller, window);
            var modelBoxTopInWindow = (window is null || modelBox is null) ? double.NaN : BoundsTopIn(modelBox, window);
            var modelBoxBottomInWindow = (window is null || modelBox is null) ? double.NaN : BoundsBottomIn(modelBox, window);
            var bottomHintBottomInWindow = (window is null || bottomText is null) ? double.NaN : BoundsBottomIn(bottomText, window);

            // 最底部可见控件的判定（窗口坐标）：模型输入框之下、仍在滚动视口内的最低可见文本。
            // 与"模型输入框下方 40px"那套不同，这一条与具体文案无关，因此对四个状态都成立。
            double lowestTextBottomInWindow = double.NaN;
            string? lowestText = null;
            if (window is not null)
            {
                foreach (var t in view.GetVisualDescendants().OfType<TextBlock>())
                {
                    if (!t.IsEffectivelyVisible || string.IsNullOrWhiteSpace(t.Text)) continue;
                    var botW = BoundsBottomIn(t, window);
                    if (!IsFinite(botW)) continue;
                    if (botW > lowestTextBottomInWindow || double.IsNaN(lowestTextBottomInWindow))
                    {
                        lowestTextBottomInWindow = botW;
                        lowestText = t.Text;
                    }
                }
            }

            // 权威判定（窗口坐标，不依赖视口元数据）：最后一行文本的底边必须落在窗口客户区内、
            // 且不超出滚动视口底边 —— 这正是"底部文案被裁半行"的几何反例。
            var bottomLineVisible = IsFinite(lowestTextBottomInWindow) && IsFinite(winClientH)
                                    && lowestTextBottomInWindow <= winClientH + 0.5
                                    && (!IsFinite(scrollerBottomInWindow)
                                        || lowestTextBottomInWindow <= scrollerBottomInWindow + 0.5);

            var noScrollNeeded = extentH <= viewportH + 0.5;
            var bottomInside = IsFinite(bottomTextBottom) && bottomTextBottom <= viewportH + 0.5;
            var fits = noScrollNeeded && bottomInside && bottomLineVisible;

            return new Dictionary<string, object?>
            {
                ["scope"] = "llm-tab-scrollviewer",
                ["extentHeight"] = Finite(extentH),
                ["viewportHeight"] = Finite(viewportH),
                ["offsetY"] = Finite(offsetY),
                ["noVerticalScrollNeeded"] = noScrollNeeded,
                ["verticalScrollBarVisible"] = scrollBarVisible,
                ["bottomMostControlText"] = bottomText?.Text,
                ["bottomMostControlBottom"] = Finite(bottomTextBottom),
                ["bottomWithinViewport"] = bottomInside,
                ["modelTextBoxBottom"] = Finite(modelBoxBottom),
                ["fits"] = fits,
                // 绝对坐标（相对窗口客户区）——判定的权威依据，语义无歧义：
                ["windowClientHeight"] = Finite(winClientH),
                ["scrollerTopInWindow"] = Finite(scrollerTopInWindow),
                ["scrollerBottomInWindow"] = Finite(scrollerBottomInWindow),
                ["modelTextBoxTopInWindow"] = Finite(modelBoxTopInWindow),
                ["modelTextBoxBottomInWindow"] = Finite(modelBoxBottomInWindow),
                ["bottomHintBottomInWindow"] = Finite(bottomHintBottomInWindow),
                ["lowestVisibleText"] = lowestText,
                ["lowestVisibleTextBottomInWindow"] = Finite(lowestTextBottomInWindow),
                ["bottomLineVisible"] = bottomLineVisible,
            };
        }
        catch (Exception ex)
        {
            return new Dictionary<string, object?> { ["error"] = ex.GetType().Name + ": " + ex.Message };
        }
    }

    private static double BoundsTopIn(Avalonia.Visual v, Avalonia.Visual relativeTo)
    {
        var p = v.TranslatePoint(new Point(0, 0), relativeTo);
        return p?.Y ?? double.NaN;
    }

    private static double BoundsBottomIn(Avalonia.Visual v, Avalonia.Visual relativeTo)
    {
        var p = v.TranslatePoint(new Point(0, 0), relativeTo);
        return p is null ? double.NaN : p.Value.Y + v.Bounds.Height;
    }

    private static bool IsFinite(double d) => !double.IsNaN(d) && !double.IsInfinity(d);

    /// <summary>
    /// 把几何量写成可 JSON 序列化的值：非有限值（NaN/±∞，本探针用它们表示"未找到控件"）
    /// 一律写成 null。
    /// ★ 必须自己判有限性：`Math.Round(double.PositiveInfinity)` 会抛 ArgumentException，
    /// 而异常发生在 Emit 序列化期会让**整个状态的协议行丢失**（2026-10-12 实测：状态 D 因此消失，
    /// 且 Finish 聚合仍显示 4/4 全好）——这是最危险的一类静默证据丢失。
    /// </summary>
    private static object? Finite(double d) => IsFinite(d) ? Math.Round(d, 1) : (object?)null;

    /// <summary>通道 A：Avalonia RenderTargetBitmap —— 只渲染本应用自己的可视树。</summary>
    private static Dictionary<string, object?> CaptureAvaloniaPng(Avalonia.Controls.Window? window, string pngPath)
    {
        var r = new Dictionary<string, object?> { ["Method"] = "avalonia-rendertargetbitmap", ["Ok"] = false };
        try
        {
            if (window is null)
            {
                r["Error"] = "MainWindow is null";
                return r;
            }
            var w = (int)Math.Round(window.ClientSize.Width);
            var h = (int)Math.Round(window.ClientSize.Height);
            if (w <= 0 || h <= 0)
            {
                r["Error"] = $"invalid client size {w}x{h}";
                return r;
            }
            var rtb = new RenderTargetBitmap(new PixelSize(w, h), new Vector(96, 96));
            rtb.Render(window);
            rtb.Save(pngPath);
            rtb.Dispose();

            r["Path"] = pngPath;
            r["Width"] = w;
            r["Height"] = h;
            r["Bytes"] = new FileInfo(pngPath).Length;
            r["Sha256"] = Sha256File(pngPath);
            r["Ok"] = true;
        }
        catch (Exception ex)
        {
            r["Error"] = ex.GetType().Name + ": " + ex.Message;
        }
        return r;
    }

    /// <summary>通道 B：纯 Win32 PrintWindow(自己的 HWND) → 手工 24bpp BMP（原始像素可被 probe 解析）。</summary>
    private static Dictionary<string, object?> CaptureWin32Bmp(nint hwnd, string bmpPath)
    {
        var r = new Dictionary<string, object?> { ["Method"] = "win32-printwindow-hwnd", ["Ok"] = false };
        try
        {
            if (hwnd == 0)
            {
                r["Error"] = "hwnd is 0";
                return r;
            }
            if (!OperatingSystem.IsWindows())
            {
                r["Error"] = "not windows";
                return r;
            }
            if (!NativeMethods.GetWindowRect(hwnd, out var wr))
            {
                r["Error"] = "GetWindowRect failed";
                return r;
            }
            var w = wr.Right - wr.Left;
            var h = wr.Bottom - wr.Top;
            if (w <= 0 || h <= 0)
            {
                r["Error"] = $"invalid window size {w}x{h}";
                return r;
            }
            if (!NativeMethods.PrintWindowToBmp(hwnd, w, h, bmpPath, out var flagsUsed, out var uniform))
            {
                r["Error"] = "PrintWindowToBmp returned false";
                return r;
            }

            r["Path"] = bmpPath;
            r["Width"] = w;
            r["Height"] = h;
            r["Bytes"] = new FileInfo(bmpPath).Length;
            r["Sha256"] = Sha256File(bmpPath);
            r["FlagsUsed"] = "0x" + flagsUsed.ToString("X");
            // 单一色 = PrintWindow 没拿到真实合成内容。Avalonia 走 Skia/ANGLE 的 GPU 合成，
            // PrintWindow（即使 PW_RENDERFULLCONTENT）常只能得到全黑；这是**环境限制**而非失败：
            // 窗口"真的被画过"由 Avalonia RenderTargetBitmap 的 PNG 通道独立证明（见 shotPng*）。
            r["Uniform"] = uniform;
            r["Note"] = uniform ? "PrintWindow 得到单一色（GPU 合成窗口的已知限制）；以 PNG 通道为准" : null;
            r["Ok"] = true;
        }
        catch (Exception ex)
        {
            r["Error"] = ex.GetType().Name + ": " + ex.Message;
        }
        return r;
    }

    private static string Sha256File(string path)
    {
        using var sha = SHA256.Create();
        using var fs = File.OpenRead(path);
        return Convert.ToHexString(sha.ComputeHash(fs)).ToLowerInvariant();
    }

    /// <summary>向 stdout 输出协议行（纯 ASCII：非 ASCII 字符由 JSON 序列化器转义为 \uXXXX）。</summary>
    private static void Emit(Dictionary<string, object?> payload)
    {
        try
        {
            var json = JsonSerializer.Serialize(payload);
            Console.Out.WriteLine(Prefix + json);
            Console.Out.Flush();
        }
        catch (Exception ex)
        {
            // ★ 序列化失败绝不能让整条协议行消失（2026-10-12 实测：状态 D 因 Math.Round(±∞) 抛
            //   ArgumentException 而**完全没有输出**，WSL 侧只看得到 3/4 个状态）。
            //   这里退化为**手写 JSON** 的最小事实行：阶段名 + 异常类型 + 消息（消息里的引号做转义）。
            try
            {
                var phase = payload.TryGetValue("phase", out var ph) ? ph?.ToString() ?? "" : "";
                var stage = payload.TryGetValue("stage", out var st) ? st?.ToString() ?? "" : "";
                var msg = (ex.Message ?? "").Replace("\\", "/").Replace("\"", "'");
                Console.Out.WriteLine(Prefix + "{\"ok\":false,\"stage\":\"" + stage
                                      + "\",\"phase\":\"" + phase + "\",\"pid\":" + Environment.ProcessId
                                      + ",\"error\":\"" + ex.GetType().Name + ": " + msg + "\"}");
                Console.Out.Flush();
            }
            catch { /* 输出通道不可用时只能放弃 */ }
        }
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct RECT
    {
        public int Left;
        public int Top;
        public int Right;
        public int Bottom;
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct BITMAPINFOHEADER
    {
        public int biSize;
        public int biWidth;
        public int biHeight;
        public short biPlanes;
        public short biBitCount;
        public int biCompression;
        public int biSizeImage;
        public int biXPelsPerMeter;
        public int biYPelsPerMeter;
        public int biClrUsed;
        public int biClrImportant;
    }

    private static class NativeMethods
    {
        // 这三个常量必须是 uint：new[]{ PW_RENDERFULLCONTENT, PW_CLIENTONLY } 会被推断成 int[]，
        // 而 PrintWindow 的第 3 参是 uint，int 变量不能隐式转换（Linux 编译门已实测捕获）。
        private const uint PW_RENDERFULLCONTENT = 0x00000002;
        private const uint PW_CLIENTONLY = 0x00000001;
        private const uint DIB_RGB_COLORS = 0;

        [DllImport("user32.dll", SetLastError = true)]
        [return: MarshalAs(UnmanagedType.Bool)]
        internal static extern bool IsWindowVisible(nint hWnd);

        [DllImport("user32.dll", SetLastError = true)]
        [return: MarshalAs(UnmanagedType.Bool)]
        internal static extern bool GetWindowRect(nint hWnd, out RECT lpRect);

        [DllImport("user32.dll", SetLastError = true)]
        [return: MarshalAs(UnmanagedType.Bool)]
        internal static extern bool GetClientRect(nint hWnd, out RECT lpRect);

        [DllImport("user32.dll", SetLastError = true)]
        private static extern bool PrintWindow(nint hwnd, nint hdcBlt, uint nFlags);

        // 取**自己窗口**的 DC，仅作内存 DC 的「格式参考」；绝不对任何 DC 做 BitBlt，也绝不取桌面 DC。
        [DllImport("user32.dll", SetLastError = true)]
        private static extern nint GetDC(nint hWnd);

        [DllImport("user32.dll", SetLastError = true)]
        private static extern int ReleaseDC(nint hWnd, nint hDC);

        [DllImport("gdi32.dll", SetLastError = true)]
        private static extern nint CreateCompatibleDC(nint hdc);

        // CreateDIBSection：直接得到一块**真 24bpp BI_RGB** 的 DIB，像素格式由 DIB header 决定，
        // 与 DC 当前选中的位图（CreateCompatibleDC 后初始是 1x1 单色）彻底无关。
        [DllImport("gdi32.dll", SetLastError = true)]
        private static extern nint CreateDIBSection(nint hdc, ref BITMAPINFOHEADER pbmi, uint usage, out nint ppvBits, nint hSection, uint offset);

        [DllImport("gdi32.dll", SetLastError = true)]
        private static extern nint SelectObject(nint hdc, nint h);

        [DllImport("gdi32.dll", SetLastError = true)]
        [return: MarshalAs(UnmanagedType.Bool)]
        private static extern bool DeleteObject(nint ho);

        [DllImport("gdi32.dll", SetLastError = true)]
        [return: MarshalAs(UnmanagedType.Bool)]
        private static extern bool DeleteDC(nint hdc);

        /// <summary>
        /// 用 PrintWindow 把**指定 HWND** 画进内存 DIB，并手工写 24bpp BMP（不依赖任何图像库）。
        ///
        /// 关键修复（父代理 2026-10-12 指出的两处真实缺陷）：
        ///   1) 旧实现 CreateCompatibleDC(0) + CreateCompatibleBitmap(memDc,w,h)：新建内存 DC 初始选中的是
        ///      1x1 **单色**位图，因此 compatible bitmap 会按**单色**格式创建，随后按 24bpp 调 GetDIBits
        ///      必然拿不到真彩色。现改为 **CreateDIBSection**，直接申请真 24bpp BI_RGB 的 DIB，
        ///      格式与 DC 当前位图无关；内存 DC 的格式参考取自**自己窗口**的 GetDC(hwnd)。
        ///   2) 旧实现在位图**仍被选入 DC** 时调用 GetDIBits（MSDN 要求位图不得被选入 DC）。
        ///      现直接读 CreateDIBSection 返回的 ppvBits 内存，**完全不调用 GetDIBits**，该限制自然消失。
        /// 全程不做 BitBlt、不取桌面 DC ⇒ 只可能捕获**本窗口自己**。
        /// </summary>
        internal static bool PrintWindowToBmp(nint hwnd, int w, int h, string outPath, out uint flagsUsed, out bool uniform)
        {
            flagsUsed = 0;
            uniform = false;
            if (hwnd == 0) return false;

            var stride = ((w * 3 + 3) / 4) * 4;
            var size = stride * h;

            var header = new BITMAPINFOHEADER
            {
                biSize = Marshal.SizeOf<BITMAPINFOHEADER>(),
                biWidth = w,
                biHeight = h,          // 正数 = bottom-up，与 BMP 行序一致，无需翻转
                biPlanes = 1,
                biBitCount = 24,       // 真 24bpp
                biCompression = 0,     // BI_RGB
                biSizeImage = size,
                biXPelsPerMeter = 2835,
                biYPelsPerMeter = 2835,
            };

            var hdcWindow = GetDC(hwnd);                 // 仅自己窗口；仅作格式参考
            if (hdcWindow == 0) return false;
            var memDc = CreateCompatibleDC(hdcWindow);
            if (memDc == 0) { ReleaseDC(hwnd, hdcWindow); return false; }

            var hbm = CreateDIBSection(memDc, ref header, DIB_RGB_COLORS, out var ppvBits, 0, 0);
            if (hbm == 0 || ppvBits == 0) { DeleteDC(memDc); ReleaseDC(hwnd, hdcWindow); return false; }

            var old = SelectObject(memDc, hbm);
            try
            {
                var pixels = new byte[size];

                // 先 PW_RENDERFULLCONTENT（向 DWM 要完整合成内容）；若整幅仍是单一色，再退到 PW_CLIENTONLY。
                // 记录实际生效的旗标与"是否单一色"，供上层/WSL 侧如实呈现（不做任何 BitBlt、不取桌面 DC）。
                foreach (var flags in new[] { PW_RENDERFULLCONTENT, PW_CLIENTONLY })
                {
                    if (!PrintWindow(hwnd, memDc, flags))
                        continue;
                    flagsUsed = flags;
                    Marshal.Copy(ppvBits, pixels, 0, size);   // 直接读 DIB 内存；无需 GetDIBits、无需先反选
                    uniform = IsUniform(pixels);
                    if (!uniform)
                        break;
                }

                using var fs = new FileStream(outPath, FileMode.Create, FileAccess.Write, FileShare.None);
                using var bw = new BinaryWriter(fs);
                const int offBits = 14 + 40;
                bw.Write((byte)'B'); bw.Write((byte)'M');
                bw.Write(offBits + size);
                bw.Write(0);
                bw.Write(offBits);
                bw.Write(40);
                bw.Write(w);
                bw.Write(h);
                bw.Write((short)1);
                bw.Write((short)24);
                bw.Write(0);
                bw.Write(size);
                bw.Write(2835);
                bw.Write(2835);
                bw.Write(0);
                bw.Write(0);
                bw.Write(pixels);
                return true;
            }
            finally
            {
                if (old != 0) SelectObject(memDc, old);
                DeleteObject(hbm);
                DeleteDC(memDc);
                ReleaseDC(hwnd, hdcWindow);
            }
        }

        /// <summary>整幅是否只有一种 R/G/B 组合（用于判定 PrintWindow 是否真的画出了内容）。</summary>
        private static bool IsUniform(byte[] px)
        {
            if (px.Length < 3) return true;
            byte b0 = px[0], b1 = px[1], b2 = px[2];
            for (var i = 3; i + 2 < px.Length; i += 3)
            {
                if (px[i] != b0 || px[i + 1] != b1 || px[i + 2] != b2)
                    return false;
            }
            return true;
        }
    }
}
