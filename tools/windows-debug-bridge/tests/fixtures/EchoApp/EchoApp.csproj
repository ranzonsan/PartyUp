<Project Sdk="Microsoft.NET.Sdk">

  <!--
    被测宿主程序（fixture）。
    刻意自包含：显式声明 TargetFramework / OutputType，不依赖仓库根的
    Directory.Build.props 或 Directory.Packages.props —— 因为桥会把源码
    复制到仓库之外（%LOCALAPPDATA%\WslDebugBridge）再构建/运行。
    不允许任何 NuGet 引用（纯 BCL），保证离线可还原。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EchoApp</AssemblyName>
    <RootNamespace>EchoApp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
